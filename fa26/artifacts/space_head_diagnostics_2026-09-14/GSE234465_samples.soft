^SAMPLE = GSM7469191
!Sample_title = GC-YA-NOES-1
!Sample_geo_accession = GSM7469191
!Sample_status = Public on Sep 20 2023
!Sample_submission_date = Jun 08 2023
!Sample_last_update_date = Sep 20 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = YA myobundles, ground control, Day18
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: Skeletal muscle
!Sample_characteristics_ch1 = cell line: Enriched CD56+ myoblasts
!Sample_characteristics_ch1 = cell type: Wild type ( cell line)
!Sample_characteristics_ch1 = biorep: rep1
!Sample_characteristics_ch1 = treatment: Earth control (Non EStim)
!Sample_treatment_protocol_ch1 = Young- and old-derived skeletal muscle myobundles were exposed to microgravity for 10 days and matching ground control group
!Sample_growth_protocol_ch1 = Injectable hydrogel mixtures (3.3 mg/mL rat tail collagen I, and 22% (v/v) Matrigel) were combined with YA- and OS-derived CD56+ enriched myoblasts. The cell-laden hydrogels were injected into the PDMS chips to a final cell density of 15 and 20 million cells/mL for YA- and OS-derived cells, respectively. Cells were allowed to polymerize at 37°C for 60 min and seeding ports were sealed using polylactic acid (PLA, Makerbot, Brooklyn, NY) plugs. Chips were perfused with degassed Skeletal Muscle Growth media supplemented with 0.1 mg/ml Primocin (InvivoGen, San Diego, CA) at a constant flow rate of 1 mL/h at 37°C and 5% CO2.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA was harvested using Quiagen kit. Illumina TruSeq RNA Sample Prep Kit (Cat#) was used with 0.5 ug of total RNA for the construction of sequencing libraries.
!Sample_extract_protocol_ch1 = RNA libraries were prepared for sequencing using standard Illumina protocols
!Sample_data_processing = Reads were trimmed with trimmomatic, and QC was performed using FastQC.
!Sample_data_processing = Reads were mapped to the GRCh38 transcriptome using STAR and gene expression was quantified with RSEM.
!Sample_data_processing = Differential expression analysis was performed with DESeq2.
!Sample_data_processing = Assembly: GRCh38
!Sample_data_processing = Supplementary files format and content: tab-delimited files containing estimated count and FPKM for each gene in every sample
!Sample_platform_id = GPL24676
!Sample_contact_name = Alberto,,Riva
!Sample_contact_email = ariva@ufl.edu
!Sample_contact_laboratory = Bioinformatics Core
!Sample_contact_department = ICBR
!Sample_contact_institute = University of Florida
!Sample_contact_address = 2033 Mowry Rd
!Sample_contact_city = Gainesville
!Sample_contact_state = FL
!Sample_contact_zip/postal_code = 32605
!Sample_contact_country = USA
!Sample_instrument_model = Illumina NovaSeq 6000
!Sample_library_selection = cDNA
!Sample_library_source = transcriptomic
!Sample_library_strategy = RNA-Seq
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN35676483
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX20639793
!Sample_supplementary_file_1 = NONE
