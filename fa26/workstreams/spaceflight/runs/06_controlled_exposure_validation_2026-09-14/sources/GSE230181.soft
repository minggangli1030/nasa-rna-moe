^SERIES = GSE230181
!Series_title = Senescence-associatedmolecular signatures integrated with human gene co-expressionnetworks revealsCOL6A3 asnovelmediator [1]
!Series_geo_accession = GSE230181
!Series_status = Public on Nov 02 2023
!Series_submission_date = Apr 20 2023
!Series_last_update_date = Apr 02 2024
!Series_pubmed_id = 37938972
!Series_summary = We report expression profiles of various senescent cell types and modes of induction.
!Series_overall_design = 5 different non-transformed cell types from various origin were rendered senescent via ionising radiation and RNAseq was perfomed.  One strain (IMR90) was induced to senesce using various methods.  DEG Sen vs non-senescent cells were determined and compared accross all types of senescence.
!Series_type = Expression profiling by high throughput sequencing
